rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // Replace the email below with your own Google account email.
    function isOwner() {
      return signedIn()
        && request.auth.token.email == 'YOUR_GOOGLE_EMAIL_HERE';
    }

    match /question-bank-uploads/{allPaths=**} {
      allow read, write: if isOwner();
    }
  }
}
